+        if (Test-Path -LiteralPath $node) {
+            if ((Get-Item -LiteralPath $node -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { return $false }
+        }
+        $parent = [IO.Directory]::GetParent($node)
+        $node = if ($parent) {$parent.FullName} else {$null}
+    }
+    return $true
