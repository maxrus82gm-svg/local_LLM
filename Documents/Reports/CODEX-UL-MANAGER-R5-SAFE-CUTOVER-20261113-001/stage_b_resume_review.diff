+    to_text = advapi.ConvertSecurityDescriptorToStringSecurityDescriptorW
+    to_text.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint,
+                       ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_uint)]
