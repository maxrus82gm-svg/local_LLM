+                    if key == "status":
+                        rows = raw.get("managers", [])
+                        result[key] = [{k: row[k] for k in ("manager_id", "status", "snapshot", "error") if k in row}
+                                       for row in rows]
+                    else:
+                        result[key] = {"http": 200, "body": raw}
