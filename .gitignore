# Ultra LLM: source and safe evidence go to Git; mutable runtime/build artifacts do not.
# Physical project root remains M:\GitHub\local_LLM on owner's machine.
# Do not assume this retroactively untracks files already committed in main.

# Python/Node/build caches
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/node_modules/
**/dist/
**/build/

# Local installed client, staging, archives and temporary QA under the SAME project root.
/Production/
/Backups/
/Test/
/Releases/
# Historical material brought into main at commit 29 is READ-ONLY pending inventory.
# Prevent new generated contents being added accidentally; existing tracked files remain tracked.
/Pernos/UltraLLM_Builds/.venv/
/Pernos/UltraLLM_Builds/Debug_*/
/Pernos/UltraLLM_Builds/QA_*/
/Pernos/UltraLLM_Builds/Stable_Backups/
/Pernos/UltraLLM_Builds/Release/*/QA/ActualInstalledChrome*/
/Pernos/UltraLLM_Builds/Release/*/QA/ActualInstalledChrome_Final*/

# Browser profiles / local transient state
**/ChromeProfile/
**/User Data/
**/GPUCache/
**/Code Cache/
**/Cache/
**/Crashpad/

# Private user configuration and authentication: never add to Git.
**/.env
**/.env.*
**/managers.json
**/manager.json
**/setup.json
**/*.pfx
**/*.p12
**/*.key
**/*private*.pem
**/*secret*.json
**/*token*.json
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal
